{
  "name": "dkit",
  "version": "0.1.0",
  "description": "Install Directus modules — schema, permissions, flows, and frontend code you own",
  "license": "MIT",
  "type": "module",
  "homepage": "https://dkit.run",
  "bin": {
    "dkit": "./dist/bin.js"
  },
  "files": [
    "dist",
    "vendor",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martijnmichel/dkit.git"
  },
  "keywords": [
    "directus",
    "cli",
    "schema",
    "components",
    "nextjs",
    "registry"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/copy-registry.mjs && tsup && node ./scripts/chmod-bin.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/bin.ts",
    "link:global": "pnpm build && pnpm link --global",
    "test": "node --import tsx --test src/**/*.test.ts",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@directus/sdk": "^18.0.3",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@dkit/schema": "workspace:*",
    "@dkit/shared": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}

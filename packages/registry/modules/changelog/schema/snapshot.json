{
  "format": "dkit.rest",
  "collections": [
    {
      "collection": "changelog",
      "schema": null,
      "meta": {
        "icon": "history_edu",
        "color": "#0F766E",
        "collapse": "open",
        "translations": [
          {
            "language": "en-US",
            "translation": "Changelog",
            "singular": "Changelog",
            "plural": "Changelog"
          }
        ]
      }
    },
    {
      "collection": "releases",
      "schema": {},
      "meta": {
        "icon": "rocket_launch",
        "color": "#0F766E",
        "group": "changelog",
        "display_template": "{{version}} — {{title}}",
        "sort": 1,
        "translations": [
          {
            "language": "en-US",
            "translation": "Releases",
            "singular": "Release",
            "plural": "Releases"
          }
        ],
        "note": "Product releases and roadmap items"
      },
      "fields": [
        {
          "field": "id",
          "type": "uuid",
          "meta": {
            "hidden": true,
            "readonly": true,
            "interface": "input",
            "special": ["uuid"],
            "sort": 1,
            "width": "full",
            "translations": [{ "language": "en-US", "translation": "ID" }]
          },
          "schema": {
            "is_primary_key": true,
            "length": 36,
            "has_auto_increment": false
          }
        },
        {
          "field": "status",
          "type": "string",
          "meta": {
            "interface": "select-dropdown",
            "display": "labels",
            "width": "half",
            "sort": 2,
            "options": {
              "choices": [
                { "text": "Shipped", "value": "shipped" },
                { "text": "In progress", "value": "in_progress" },
                { "text": "Planned", "value": "planned" }
              ]
            },
            "display_options": {
              "choices": [
                {
                  "text": "Shipped",
                  "value": "shipped",
                  "foreground": "#FFFFFF",
                  "background": "#0F766E"
                },
                {
                  "text": "In progress",
                  "value": "in_progress",
                  "foreground": "#44403C",
                  "background": "#FDE68A"
                },
                {
                  "text": "Planned",
                  "value": "planned",
                  "foreground": "#44403C",
                  "background": "#E7E5E4"
                }
              ]
            },
            "translations": [{ "language": "en-US", "translation": "Status" }],
            "note": "Current delivery state"
          },
          "schema": { "default_value": "planned", "is_nullable": false }
        },
        {
          "field": "released_at",
          "type": "timestamp",
          "meta": {
            "interface": "datetime",
            "display": "datetime",
            "width": "half",
            "sort": 3,
            "translations": [
              { "language": "en-US", "translation": "Released at" }
            ],
            "note": "When this shipped (or target date)"
          },
          "schema": {}
        },
        {
          "field": "version",
          "type": "string",
          "meta": {
            "interface": "input",
            "required": true,
            "width": "half",
            "sort": 4,
            "options": { "trim": true, "placeholder": "1.2.0" },
            "translations": [{ "language": "en-US", "translation": "Version" }],
            "note": "Semver or release label"
          },
          "schema": { "is_nullable": false }
        },
        {
          "field": "title",
          "type": "string",
          "meta": {
            "interface": "input",
            "required": true,
            "width": "half",
            "sort": 5,
            "options": { "trim": true },
            "translations": [{ "language": "en-US", "translation": "Title" }]
          },
          "schema": { "is_nullable": false }
        },
        {
          "field": "tags",
          "type": "csv",
          "meta": {
            "interface": "tags",
            "width": "full",
            "sort": 6,
            "translations": [{ "language": "en-US", "translation": "Tags" }],
            "note": "e.g. feature, fix, breaking"
          },
          "schema": {}
        },
        {
          "field": "body",
          "type": "text",
          "meta": {
            "interface": "input-rich-text-html",
            "width": "fill",
            "sort": 7,
            "options": {
              "toolbar": [
                "bold",
                "italic",
                "h2",
                "h3",
                "numlist",
                "bullist",
                "link",
                "code",
                "empty"
              ]
            },
            "translations": [
              { "language": "en-US", "translation": "Release notes" }
            ],
            "note": "Detailed changelog for this release"
          },
          "schema": {}
        }
      ]
    }
  ],
  "relations": []
}

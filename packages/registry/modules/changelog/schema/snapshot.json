{
  "format": "dkit.rest",
  "collections": [
    {
      "collection": "releases",
      "schema": {},
      "meta": {
        "icon": "campaign",
        "display_template": "{{version}} — {{title}}"
      },
      "fields": [
        {
          "field": "id",
          "type": "uuid",
          "meta": {
            "hidden": true,
            "readonly": true,
            "interface": "input",
            "special": ["uuid"]
          },
          "schema": {
            "is_primary_key": true,
            "length": 36,
            "has_auto_increment": false
          }
        },
        {
          "field": "status",
          "type": "string",
          "meta": {
            "interface": "select-dropdown",
            "options": {
              "choices": [
                { "text": "Shipped", "value": "shipped" },
                { "text": "In progress", "value": "in_progress" },
                { "text": "Planned", "value": "planned" }
              ]
            },
            "display": "labels"
          },
          "schema": { "default_value": "planned", "is_nullable": false }
        },
        {
          "field": "version",
          "type": "string",
          "meta": { "interface": "input", "required": true },
          "schema": { "is_nullable": false }
        },
        {
          "field": "title",
          "type": "string",
          "meta": { "interface": "input", "required": true },
          "schema": { "is_nullable": false }
        },
        {
          "field": "body",
          "type": "text",
          "meta": { "interface": "input-rich-text-html" },
          "schema": {}
        },
        {
          "field": "tags",
          "type": "csv",
          "meta": { "interface": "tags" },
          "schema": {}
        },
        {
          "field": "released_at",
          "type": "timestamp",
          "meta": { "interface": "datetime" },
          "schema": {}
        }
      ]
    }
  ],
  "relations": []
}

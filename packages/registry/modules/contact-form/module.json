{
  "type": "dkit:module",
  "id": "contact-form",
  "title": "Contact form",
  "description": "Public form → Directus inbox. Optional email notify if Directus mail is configured.",
  "version": "0.1.0",
  "directus": { "min": "11.0.0" },
  "dependencies": ["@directus/sdk", "zod"],
  "layers": ["schema", "access", "services", "types"],
  "defaultBlocks": ["contact-form-ui"],
  "collections": ["site", "form_submissions"],
  "defaultBasePath": "/contact"
}

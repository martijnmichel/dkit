{
  "format": "dkit.rest",
  "collections": [
    {
      "collection": "form_submissions",
      "schema": {},
      "meta": {
        "icon": "inbox",
        "display_template": "{{email}} — {{created_at}}"
      },
      "fields": [
        {
          "field": "id",
          "type": "uuid",
          "meta": {
            "hidden": true,
            "readonly": true,
            "interface": "input",
            "special": ["uuid"]
          },
          "schema": {
            "is_primary_key": true,
            "length": 36,
            "has_auto_increment": false
          }
        },
        {
          "field": "name",
          "type": "string",
          "meta": { "interface": "input", "required": true },
          "schema": { "is_nullable": false }
        },
        {
          "field": "email",
          "type": "string",
          "meta": { "interface": "input", "required": true },
          "schema": { "is_nullable": false }
        },
        {
          "field": "message",
          "type": "text",
          "meta": { "interface": "input-multiline", "required": true },
          "schema": { "is_nullable": false }
        },
        {
          "field": "created_at",
          "type": "timestamp",
          "meta": {
            "interface": "datetime",
            "special": ["date-created"],
            "readonly": true
          },
          "schema": {}
        }
      ]
    }
  ],
  "relations": []
}

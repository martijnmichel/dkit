{
  "format": "dkit.rest",
  "collections": [
    {
      "collection": "site",
      "schema": null,
      "meta": {
        "icon": "web",
        "color": "#0F766E",
        "collapse": "open",
        "translations": [
          {
            "language": "en-US",
            "translation": "Site",
            "singular": "Site",
            "plural": "Site"
          }
        ],
        "note": "Site content and chrome — pages, settings, navigation, contact, page builder"
      }
    },
    {
      "collection": "form_submissions",
      "schema": {},
      "meta": {
        "icon": "inbox",
        "color": "#0F766E",
        "group": "site",
        "display_template": "{{name}} — {{email}}",
        "archive_field": "status",
        "archive_value": "archived",
        "unarchive_value": "new",
        "archive_app_filter": true,
        "sort": 10,
        "translations": [
          {
            "language": "en-US",
            "translation": "Form submissions",
            "singular": "Submission",
            "plural": "Submissions"
          }
        ],
        "note": "Stored in Directus as an inbox. Wire the optional notify flow only if email is configured."
      },
      "fields": [
        {
          "field": "id",
          "type": "uuid",
          "meta": {
            "hidden": true,
            "readonly": true,
            "interface": "input",
            "special": ["uuid"],
            "sort": 1,
            "width": "full",
            "translations": [{ "language": "en-US", "translation": "ID" }]
          },
          "schema": {
            "is_primary_key": true,
            "length": 36,
            "has_auto_increment": false
          }
        },
        {
          "field": "status",
          "type": "string",
          "meta": {
            "interface": "select-dropdown",
            "display": "labels",
            "width": "half",
            "sort": 2,
            "options": {
              "choices": [
                { "text": "New", "value": "new" },
                { "text": "Read", "value": "read" },
                { "text": "Archived", "value": "archived" }
              ]
            },
            "display_options": {
              "choices": [
                {
                  "text": "New",
                  "value": "new",
                  "foreground": "#FFFFFF",
                  "background": "#0F766E"
                },
                {
                  "text": "Read",
                  "value": "read",
                  "foreground": "#44403C",
                  "background": "#E7E5E4"
                },
                {
                  "text": "Archived",
                  "value": "archived",
                  "foreground": "#FFFFFF",
                  "background": "#A8A29E"
                }
              ]
            },
            "translations": [{ "language": "en-US", "translation": "Status" }],
            "note": "Inbox triage in the Directus dashboard",
            "validation": {
              "_and": [{ "status": { "_in": ["new", "read", "archived"] } }]
            },
            "validation_message": "Choose New, Read, or Archived."
          },
          "schema": { "default_value": "new", "is_nullable": false }
        },
        {
          "field": "created_at",
          "type": "timestamp",
          "meta": {
            "interface": "datetime",
            "display": "datetime",
            "special": ["date-created"],
            "readonly": true,
            "width": "half",
            "sort": 3,
            "translations": [
              { "language": "en-US", "translation": "Received at" }
            ],
            "note": "Set automatically when the submission is created"
          },
          "schema": {}
        },
        {
          "field": "name",
          "type": "string",
          "meta": {
            "interface": "input",
            "required": true,
            "width": "half",
            "sort": 4,
            "options": { "trim": true },
            "translations": [{ "language": "en-US", "translation": "Name" }],
            "validation": {
              "_and": [{ "name": { "_regex": "^.{1,120}$" } }]
            },
            "validation_message": "Name is required (max 120 characters)."
          },
          "schema": { "is_nullable": false, "max_length": 120 }
        },
        {
          "field": "email",
          "type": "string",
          "meta": {
            "interface": "input",
            "required": true,
            "width": "half",
            "sort": 5,
            "options": {
              "trim": true,
              "placeholder": "name@example.com",
              "iconLeft": "email"
            },
            "translations": [{ "language": "en-US", "translation": "Email" }],
            "note": "Reply-to address",
            "validation": {
              "_and": [
                {
                  "email": {
                    "_regex": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
                  }
                }
              ]
            },
            "validation_message": "Enter a valid email address."
          },
          "schema": { "is_nullable": false, "max_length": 200 }
        },
        {
          "field": "message",
          "type": "text",
          "meta": {
            "interface": "input-multiline",
            "required": true,
            "width": "full",
            "sort": 6,
            "options": { "trim": true },
            "translations": [{ "language": "en-US", "translation": "Message" }],
            "validation": {
              "_and": [{ "message": { "_regex": "^[\\s\\S]{1,5000}$" } }]
            },
            "validation_message": "Message is required (max 5000 characters)."
          },
          "schema": { "is_nullable": false }
        }
      ]
    }
  ],
  "relations": []
}

      "related_collection": "directus_files",
      "meta": {
        "many_collection": "authors",
        "many_field": "avatar",
        "one_collection": "directus_files",
        "one_field": null
      },
      "schema": {
        "on_delete": "SET NULL"
      }
    },
    {
      "collection": "posts",
      "field": "featured_image",
      "related_collection": "directus_files",
      "meta": {
        "many_collection": "posts",
        "many_field": "featured_image",
        "one_collection": "directus_files",
        "one_field": null
      },
      "schema": {
        "on_delete": "SET NULL"
      }
    },
    {
      "collection": "posts_categories",
      "field": "posts_id",
      "related_collection": "posts",
      "meta": {
        "many_collection": "posts_categories",
        "many_field": "posts_id",
        "one_collection": "posts",
        "one_field": "categories",
        "junction_field": "categories_id"
      },
      "schema": { "on_delete": "CASCADE" }
    },
    {
      "collection": "posts_categories",
      "field": "categories_id",
      "related_collection": "categories",
      "meta": {
        "many_collection": "posts_categories",

{
  "policies": [
    {
      "name": "dkit Blog Public Read",
      "icon": "public",
      "description": "Public read for blog collections (flat rules — Core-compatible). UI filters published status.",
      "admin_access": false,
      "app_access": false
    }
  ],
  "permissions": [
    {
      "policy": "dkit Blog Public Read",
      "collection": "posts",
      "action": "read",
      "fields": ["*"]
    },
    {
      "policy": "dkit Blog Public Read",
      "collection": "authors",
      "action": "read",
      "fields": ["*"]
    },
    {
      "policy": "dkit Blog Public Read",
      "collection": "categories",
      "action": "read",
      "fields": ["*"]
    },
    {
      "policy": "dkit Blog Public Read",
      "collection": "posts_categories",
      "action": "read",
      "fields": ["*"]
    },
    {
      "policy": "dkit Blog Public Read",
      "collection": "directus_files",
      "action": "read",
      "fields": ["*"]
    }
  ],
  "access": [
    {
      "role": "$public",
      "policy": "dkit Blog Public Read"
    }
  ]
}

{
  "type": "dkit:module",
  "id": "blog",
  "title": "Blog & Authors",
  "description": "Posts, authors, and categories with M2O/M2M relations",
  "version": "0.1.0",
  "directus": { "min": "11.0.0" },
  "dependencies": ["@directus/sdk"],
  "layers": ["schema", "access", "services", "types"],
  "defaultBlocks": ["blog-list", "blog-detail"],
  "templates": {
    "list": {
      "default": "blog-list",
      "options": ["blog-list", "blog-list-cards"]
    },
    "detail": {
      "default": "blog-detail",
      "options": ["blog-detail", "blog-detail-minimal"]
    }
  },
  "collections": ["blog", "authors", "categories", "posts", "posts_categories"],
  "defaultBasePath": "/blog"
}

{
  "name": "dkit",
  "homepage": "https://dkit.run",
  "version": "0.1.0",
  "items": [
    {
      "id": "blog",
      "type": "dkit:module",
      "title": "Blog & Authors",
      "description": "Posts, authors, and categories with M2O/M2M relations",
      "version": "0.1.0",
      "path": "modules/blog",
      "defaultBlocks": ["blog-list", "blog-detail"],
      "templates": {
        "list": {
          "default": "blog-list",
          "options": ["blog-list", "blog-list-cards"]
        },
        "detail": {
          "default": "blog-detail",
          "options": ["blog-detail"]
        }
      }
    },
    {
      "id": "blog-list",
      "type": "dkit:block",
      "title": "Blog list",
      "description": "Stacked post list with optional thumbnails",
      "version": "0.1.0",
      "path": "blocks/blog-list",
      "registryDependencies": ["blog"],
      "slot": "list",
      "route": { "kind": "index" },
      "frameworks": ["next", "nuxt"],
      "uiKits": ["shadcn", "minimal"]
    },
    {
      "id": "blog-list-cards",
      "type": "dkit:block",
      "title": "Blog list (cards)",
      "description": "Card grid of posts with date, excerpt, and hover accent",
      "version": "0.1.0",
      "path": "blocks/blog-list-cards",
      "registryDependencies": ["blog"],
      "slot": "list",
      "route": { "kind": "index" },
      "frameworks": ["next", "nuxt"],
      "uiKits": ["shadcn", "minimal"]
    },
    {
      "id": "blog-detail",
      "type": "dkit:block",
      "title": "Blog detail",
      "description": "Article page with categories, byline, and rich text",
      "version": "0.1.0",
      "path": "blocks/blog-detail",
      "registryDependencies": ["blog"],
      "slot": "detail",
      "route": { "kind": "slug" },
      "frameworks": ["next", "nuxt"],
      "uiKits": ["shadcn", "minimal"]
    },
    {
      "id": "pages",
      "type": "dkit:module",
      "title": "Pages (WYSIWYG)",
      "description": "Simple published pages with a rich-text body",
      "version": "0.1.0",
      "path": "modules/pages",
      "defaultBlocks": ["page-detail"],
      "templates": {
        "detail": {
          "default": "page-detail",
          "options": ["page-detail"]
        }
      }
    },
    {
      "id": "page-detail",
      "type": "dkit:block",
      "title": "Page detail",
      "description": "WYSIWYG page view with title, excerpt, and body",
      "version": "0.1.0",
      "path": "blocks/page-detail",
      "registryDependencies": ["pages"],
      "slot": "detail",
      "route": { "kind": "slug" },
      "frameworks": ["next", "nuxt"],
      "uiKits": ["shadcn", "minimal"]
    },
    {
      "id": "contact-form",
      "type": "dkit:module",
      "title": "Contact form",
      "description": "Public form → Directus inbox; optional email if Directus mail is configured",
      "version": "0.1.0",
      "path": "modules/contact-form",
      "defaultBlocks": ["contact-form-ui"]
    },
    {
      "id": "contact-form-ui",
      "type": "dkit:block",
      "title": "Contact form UI",
      "description": "Validated contact form (Next Server Action / Nuxt client submit)",
      "version": "0.1.0",
      "path": "blocks/contact-form-ui",
      "registryDependencies": ["contact-form"],
      "slot": "form",
      "route": { "kind": "static" },
      "frameworks": ["next", "nuxt"],
      "uiKits": ["shadcn", "minimal"]
    },
    {
      "id": "page-builder",
      "type": "dkit:module",
      "title": "Dynamic Page Builder",
      "description": "Composable pages with M2A content blocks",
      "version": "0.1.0",
      "path": "modules/page-builder",
      "defaultBlocks": ["page-renderer"]
    },
    {
      "id": "page-renderer",
      "type": "dkit:block",
      "title": "Page renderer",
      "description": "Dynamic M2A block renderer",
      "version": "0.1.0",
      "path": "blocks/page-renderer",
      "registryDependencies": ["page-builder"],
      "slot": "renderer",
      "route": { "kind": "slug" },
      "frameworks": ["next", "nuxt"],
      "uiKits": ["shadcn", "minimal"]
    },
    {
      "id": "settings",
      "type": "dkit:module",
      "title": "Settings",
      "description": "Site brand and config singleton — name, logo, contact, socials, feature flags",
      "version": "0.1.0",
      "path": "modules/settings",
      "defaultBlocks": []
    },
    {
      "id": "navigation",
      "type": "dkit:module",
      "title": "Navigation",
      "description": "Named menus and link trees for headers, footers, and inline nav",
      "version": "0.1.0",
      "path": "modules/navigation",
      "defaultBlocks": ["nav-header", "nav-footer"],
      "templates": {
        "header": {
          "default": "nav-header",
          "options": ["nav-header"]
        },
        "footer": {
          "default": "nav-footer",
          "options": ["nav-footer"]
        }
      }
    },
    {
      "id": "nav-header",
      "type": "dkit:block",
      "title": "Nav header",
      "description": "Site header with primary menu — logo soft-links settings when installed",
      "version": "0.1.0",
      "path": "blocks/nav-header",
      "registryDependencies": ["navigation"],
      "slot": "header",
      "frameworks": ["next"],
      "uiKits": ["shadcn", "minimal"]
    },
    {
      "id": "nav-footer",
      "type": "dkit:block",
      "title": "Nav footer",
      "description": "Site footer with footer menu — brand/contact soft-links settings when installed",
      "version": "0.1.0",
      "path": "blocks/nav-footer",
      "registryDependencies": ["navigation"],
      "slot": "footer",
      "frameworks": ["next"],
      "uiKits": ["shadcn", "minimal"]
    }
  ]
}

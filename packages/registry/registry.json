{
  "name": "dkit",
  "homepage": "https://github.com/martijnmichel/dkit",
  "version": "0.1.0",
  "items": [
    {
      "id": "blog",
      "type": "dkit:module",
      "title": "Blog & Authors",
      "description": "Posts, authors, and categories with M2O/M2M relations",
      "version": "0.1.0",
      "path": "modules/blog",
      "defaultBlocks": ["blog-list", "blog-detail"],
      "templates": {
        "list": {
          "default": "blog-list",
          "options": ["blog-list", "blog-list-cards"]
        },
        "detail": {
          "default": "blog-detail",
          "options": ["blog-detail"]
        }
      }
    },
    {
      "id": "blog-list",
      "type": "dkit:block",
      "title": "Blog list",
      "description": "Stacked post list with optional thumbnails",
      "version": "0.1.0",
      "path": "blocks/blog-list",
      "registryDependencies": ["blog"],
      "slot": "list",
      "frameworks": ["next", "nuxt"],
      "uiKits": ["shadcn", "minimal"]
    },
    {
      "id": "blog-list-cards",
      "type": "dkit:block",
      "title": "Blog list (cards)",
      "description": "Card grid of posts with date, excerpt, and hover accent",
      "version": "0.1.0",
      "path": "blocks/blog-list-cards",
      "registryDependencies": ["blog"],
      "slot": "list",
      "frameworks": ["next", "nuxt"],
      "uiKits": ["shadcn", "minimal"]
    },
    {
      "id": "blog-detail",
      "type": "dkit:block",
      "title": "Blog detail",
      "description": "Article page with categories, byline, and rich text",
      "version": "0.1.0",
      "path": "blocks/blog-detail",
      "registryDependencies": ["blog"],
      "slot": "detail",
      "frameworks": ["next", "nuxt"],
      "uiKits": ["shadcn", "minimal"]
    },
    {
      "id": "pages",
      "type": "dkit:module",
      "title": "Pages (WYSIWYG)",
      "description": "Simple published pages with a rich-text body",
      "version": "0.1.0",
      "path": "modules/pages",
      "defaultBlocks": ["page-detail"],
      "templates": {
        "detail": {
          "default": "page-detail",
          "options": ["page-detail"]
        }
      }
    },
    {
      "id": "page-detail",
      "type": "dkit:block",
      "title": "Page detail",
      "description": "WYSIWYG page view with title, excerpt, and body",
      "version": "0.1.0",
      "path": "blocks/page-detail",
      "registryDependencies": ["pages"],
      "slot": "detail",
      "frameworks": ["next", "nuxt"],
      "uiKits": ["shadcn", "minimal"]
    },
    {
      "id": "contact-form",
      "type": "dkit:module",
      "title": "Contact form",
      "description": "Public form → Directus inbox; optional email if Directus mail is configured",
      "version": "0.1.0",
      "path": "modules/contact-form",
      "defaultBlocks": ["contact-form-ui"]
    },
    {
      "id": "contact-form-ui",
      "type": "dkit:block",
      "title": "Contact form UI",
      "description": "Validated Next.js Server Action form",
      "version": "0.1.0",
      "path": "blocks/contact-form-ui",
      "registryDependencies": ["contact-form"],
      "slot": "form",
      "frameworks": ["next"],
      "uiKits": ["shadcn", "minimal"]
    },
    {
      "id": "page-builder",
      "type": "dkit:module",
      "title": "Dynamic Page Builder",
      "description": "Composable pages with M2A content blocks",
      "version": "0.1.0",
      "path": "modules/page-builder",
      "defaultBlocks": ["page-renderer"]
    },
    {
      "id": "page-renderer",
      "type": "dkit:block",
      "title": "Page renderer",
      "description": "Dynamic M2A block renderer",
      "version": "0.1.0",
      "path": "blocks/page-renderer",
      "registryDependencies": ["page-builder"],
      "slot": "renderer",
      "frameworks": ["next"],
      "uiKits": ["shadcn", "minimal"]
    }
  ]
}

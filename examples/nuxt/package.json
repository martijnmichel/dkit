{
  "name": "@dkit/example-nuxt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3002",
    "build": "nuxt build",
    "preview": "nuxt preview --port 3002",
    "dkit:init": "node ../../packages/cli/dist/bin.js init --yes --framework nuxt --url ${DIRECTUS_URL:-http://localhost:8055} --token ${DIRECTUS_TOKEN:?set DIRECTUS_TOKEN}",
    "dkit:add-blog": "node ../../packages/cli/dist/bin.js add blog --framework nuxt --seed --force --yes --path /blog --prefix dkit_",
    "dkit:add-blog-cards": "node ../../packages/cli/dist/bin.js add blog --framework nuxt --template list=blog-list-cards,detail=blog-detail-minimal --seed --force --yes --path /blog --prefix dkit_",
    "dkit:clear": "node ./scripts/clear-dkit.mjs",
    "dkit:reset": "pnpm dkit:clear && pnpm dkit:add-blog"
  },
  "dependencies": {
    "@directus/sdk": "^18.0.3",
    "nuxt": "^3.15.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}

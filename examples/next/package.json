{
  "name": "@dkit/example-next",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "dkit:init": "node ../../packages/cli/dist/bin.js init --url ${DIRECTUS_URL:-http://localhost:8010} --token ${DIRECTUS_TOKEN}",
    "dkit:add-blog": "node ../../packages/cli/dist/bin.js add blog --seed --force --yes --path /blog --prefix dkit_",
    "dkit:add-blog-cards": "node ../../packages/cli/dist/bin.js add blog --template list=blog-list-cards,detail=blog-detail-minimal --seed --force --yes --path /blog --prefix dkit_",
    "dkit:clear": "node ./scripts/clear-dkit.mjs",
    "dkit:reset": "pnpm dkit:clear && pnpm dkit:add-blog"
  },
  "dependencies": {
    "@directus/sdk": "^18.0.3",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.2"
  }
}

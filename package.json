{
  "name": "dkit-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Install Directus modules — schema, permissions, flows, and frontend code you own",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dkit": "./bin/dkit.mjs"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "dkit": "node ./bin/dkit.mjs",
    "dkit:link": "node ./scripts/link-cli.mjs",
    "dkit:unlink": "pnpm --dir packages/cli unlink --global",
    "dev:www": "pnpm --filter @dkit/www dev",
    "typecheck": "pnpm -r --filter=./packages/* typecheck",
    "test": "pnpm -r --filter=./packages/* test",
    "lint": "pnpm -r --filter=./packages/* lint",
    "directus:up": "docker compose -f docker/directus/compose.yaml up -d",
    "directus:down": "docker compose -f docker/directus/compose.yaml down",
    "directus:reset": "docker compose -f docker/directus/compose.yaml down -v && docker compose -f docker/directus/compose.yaml up -d",
    "directus:logs": "docker compose -f docker/directus/compose.yaml logs -f",
    "www:up": "docker compose -f docker/www/compose.yaml up -d --build",
    "www:down": "docker compose -f docker/www/compose.yaml down",
    "www:logs": "docker compose -f docker/www/compose.yaml logs -f",
    "example:next:setup": "pnpm --filter dkit build && pnpm --filter @dkit/example-next exec node ../../packages/cli/dist/bin.js init --yes --url ${DIRECTUS_URL:-http://localhost:8010} --token ${DIRECTUS_TOKEN:?set DIRECTUS_TOKEN} && pnpm --filter @dkit/example-next dkit:add-blog",
    "example:next:dev": "pnpm --filter @dkit/example-next dev",
    "example:next:clear": "pnpm --filter @dkit/example-next dkit:clear",
    "example:next:reset": "pnpm example:next:clear && pnpm --filter @dkit/example-next dkit:add-blog",
    "example:nuxt:setup": "pnpm --filter dkit build && pnpm --filter @dkit/example-nuxt dkit:init && pnpm --filter @dkit/example-nuxt dkit:add-blog",
    "example:nuxt:dev": "pnpm --filter @dkit/example-nuxt dev",
    "example:nuxt:clear": "pnpm --filter @dkit/example-nuxt dkit:clear",
    "example:nuxt:reset": "pnpm example:nuxt:clear && pnpm --filter @dkit/example-nuxt dkit:add-blog"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
